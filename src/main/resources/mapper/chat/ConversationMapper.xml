<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusdoc.chat.mapper.ConversationMapper">

    <resultMap id="ConversationMap" type="com.campusdoc.chat.entity.ConversationEntity">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="title" column="title"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO conversation (user_id, title) VALUES (#{userId}, #{title})
    </insert>

    <select id="findByIdAndUserId" resultMap="ConversationMap">
        SELECT * FROM conversation WHERE id = #{id} AND user_id = #{userId}
    </select>

    <select id="listByUserId" resultMap="ConversationMap">
        SELECT * FROM conversation WHERE user_id = #{userId} ORDER BY created_at DESC
    </select>

    <delete id="deleteByIdAndUserId">
        DELETE FROM conversation WHERE id = #{id} AND user_id = #{userId}
    </delete>
</mapper>
